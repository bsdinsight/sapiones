# Sapiones - biến môi trường VPS (mẫu). Copy thành .env, điền giá trị thật:
#   cp deploy/.env.example .env

# Mật khẩu Postgres cho user "odoo". Sinh: openssl rand -hex 24
# Phải đặt TRƯỚC lần `up -d db` đầu tiên (Postgres chỉ nhận khi khởi tạo data dir rỗng).
POSTGRES_PASSWORD=

# Cloudflare Tunnel token cho tunnel "Sapiones".
# Cloudflare Zero Trust → Networks → Tunnels → (tạo tunnel) → token (eyJ...)
TUNNEL_TOKEN=
