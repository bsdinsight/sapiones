<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_dependent_list" model="ir.ui.view">
        <field name="name">hr.employee.dependent.list</field>
        <field name="model">hr.employee.dependent</field>
        <field name="arch" type="xml">
            <list string="Người phụ thuộc" editable="bottom">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="relationship"/>
                <field name="date_birth"/>
                <field name="tax_code"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="is_registered"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_dependent_form" model="ir.ui.view">
        <field name="name">hr.employee.dependent.form</field>
        <field name="model">hr.employee.dependent</field>
        <field name="arch" type="xml">
            <form string="Người phụ thuộc">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="relationship"/>
                            <field name="date_birth"/>
                        </group>
                        <group>
                            <field name="tax_code"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="is_registered"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_dependent_search" model="ir.ui.view">
        <field name="name">hr.employee.dependent.search</field>
        <field name="model">hr.employee.dependent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="tax_code"/>
                <filter name="registered" string="Đã đăng ký" domain="[('is_registered', '=', True)]"/>
                <separator/>
                <filter name="group_employee" string="Nhân viên" context="{'group_by': 'employee_id'}"/>
                <filter name="group_relationship" string="Quan hệ" context="{'group_by': 'relationship'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_dependent" model="ir.actions.act_window">
        <field name="name">Người phụ thuộc</field>
        <field name="res_model">hr.employee.dependent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có người phụ thuộc nào</p>
            <p>Khai báo người phụ thuộc để phục vụ giảm trừ gia cảnh khi tính thuế TNCN.</p>
        </field>
    </record>

    <menuitem id="menu_hr_employee_dependent"
        name="Người phụ thuộc"
        parent="hr.menu_hr_root"
        action="action_hr_employee_dependent"
        groups="hr.group_hr_user"
        sequence="95"/>

</odoo>
