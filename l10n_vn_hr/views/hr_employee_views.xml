<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_vn" model="ir.ui.view">
        <field name="name">hr.employee.form.vn</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Thông tin Việt Nam" name="vn_info" groups="hr.group_hr_user">
                    <group>
                        <group string="Giấy tờ tùy thân">
                            <field name="vn_id_card"/>
                            <field name="vn_id_card_date"/>
                            <field name="vn_id_card_place"/>
                        </group>
                        <group string="Thuế &amp; Bảo hiểm">
                            <field name="vn_tax_code"/>
                            <field name="vn_si_code"/>
                            <field name="dependent_count"/>
                        </group>
                        <group string="Thông tin khác">
                            <field name="vn_hometown"/>
                            <field name="vn_ethnicity"/>
                            <field name="vn_religion"/>
                        </group>
                    </group>
                    <group string="Người nước ngoài">
                        <field name="is_foreigner"/>
                        <field name="country_id" string="Quốc tịch" invisible="not is_foreigner"/>
                        <field name="tax_residency" invisible="not is_foreigner"/>
                        <field name="vn_passport" invisible="not is_foreigner"/>
                        <field name="vn_work_permit_no" invisible="not is_foreigner"/>
                        <field name="vn_work_permit_expiry" invisible="not is_foreigner"/>
                        <field name="vn_visa_expiry" invisible="not is_foreigner"/>
                    </group>
                    <separator string="Người phụ thuộc (giảm trừ gia cảnh)"/>
                    <field name="dependent_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="relationship"/>
                            <field name="date_birth"/>
                            <field name="tax_code"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="is_registered"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Địa chỉ riêng nhân viên theo chuẩn VN: Quốc gia → Tỉnh/TP → Phường/Xã → Địa chỉ -->
    <record id="view_employee_form_vn_address" model="ir.ui.view">
        <field name="name">hr.employee.form.vn.address</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'o_address_format')]" position="replace">
                <div class="o_address_format">
                    <field name="private_country_id" placeholder="Quốc gia" options="{'no_create': True}"/>
                    <field name="private_state_id" string="Tỉnh / Thành phố" placeholder="Tỉnh / Thành phố"
                           domain="[('country_id', '=', private_country_id)]" options="{'no_create': True}"/>
                    <field name="private_vn_ward_id" string="Phường / Xã" placeholder="Phường / Xã"
                           domain="[('state_id', '=', private_state_id)]" options="{'no_create': True}"/>
                    <field name="private_street" string="Địa chỉ" placeholder="Số nhà, tên đường..."/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
