# Sapiones Provisioning API — config mẫu. COPY thành .env và điền creds thật.
# .env BỊ GITIGNORE — KHÔNG commit creds.
# ⚠️ systemd EnvironmentFile KHÔNG hiểu comment cùng dòng — ĐỪNG để "# ..." sau
#    giá trị (sẽ bị tính vào value). Comment phải nằm trên DÒNG RIÊNG như dưới.

# nơi có docker-compose.vps.yml + demo-data/packs/
SAPIONES_REPO=/root/sapiones

# IP gateway của docker network sapiones_default — provision-api bind vào đây để
# cloudflared (container) với tới được, KHÔNG lộ ra internet. Lấy bằng:
#   docker network inspect sapiones_default --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# (Nếu lỡ `docker compose down`, network tạo lại → kiểm tra lại IP này.)
BIND_HOST=172.18.0.1

# SMTP gửi email xác nhận (sender noreply@sapiones.com) — Resend:
#   SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<API key re_...>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=__điền_API_key_Resend__
MAIL_FROM=Sapiones <noreply@sapiones.com>

ALLOWED_ORIGINS=https://sapiones.com,https://www.sapiones.com
CODE_TTL=600
PROVISION_TIMEOUT=240

# Cloudflare DNS — gói Free KHÔNG proxy được wildcard, nên mỗi tenant tạo 1 record
# proxied <id>.sapiones.com → tunnel qua API (tunnel ingress *.sapiones.com đã có sẵn).
# BASE_DOMAIN: tên miền gốc
BASE_DOMAIN=sapiones.com
# CF_API_TOKEN: token quyền Zone.DNS:Edit cho zone sapiones.com (My Profile → API Tokens
#   → Create Token → template "Edit zone DNS" → Zone Resources: sapiones.com). GIỮ BÍ MẬT.
CF_API_TOKEN=__điền_CF_API_token__
# CF_ZONE_ID: sapiones.com → trang Overview → cột phải, mục API → Zone ID
CF_ZONE_ID=__điền_Zone_ID__
# CF_TUNNEL_CNAME: target của record `api` đang chạy = <tunnel-uuid>.cfargotunnel.com
CF_TUNNEL_CNAME=__điền_tunnel-uuid__.cfargotunnel.com
