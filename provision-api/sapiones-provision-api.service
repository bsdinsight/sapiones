[Unit]
Description=Sapiones Provisioning API (register/verify → provision tenant)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/sapiones/provision-api
EnvironmentFile=/root/sapiones/provision-api/.env
# User=root để gọi được `docker compose ...` trong provision.sh
User=root
# BIND_HOST đặt trong .env = IP gateway của network sapiones_default (vd 172.18.0.1)
# để cloudflared (trong container) với tới được, mà KHÔNG lộ port 8088 ra public NIC.
# Lấy IP: docker network inspect sapiones_default --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
ExecStart=/root/sapiones/provision-api/.venv/bin/uvicorn app:app --host ${BIND_HOST} --port 8088
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
