<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_warn_days" model="ir.config_parameter">
            <field name="key">sapione_hr_certificate.warn_days</field>
            <field name="value">60</field>
        </record>

        <record id="cron_certificate_expiry" model="ir.cron">
            <field name="name">SapiOne: Nhắc hạn chứng chỉ nhân viên</field>
            <field name="model_id" ref="model_sapione_hr_certificate"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
