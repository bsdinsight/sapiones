<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Chứng chỉ ===== -->
    <record id="view_certificate_list" model="ir.ui.view">
        <field name="name">sapione.hr.certificate.list</field>
        <field name="model">sapione.hr.certificate</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="number" optional="show"/>
                <field name="issuing_organization" optional="hide"/>
                <field name="date_issued" optional="hide"/>
                <field name="date_expiry"/>
                <field name="days_to_expiry" string="Còn (ngày)"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('valid', 'no_expiry')"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_certificate_form" model="ir.ui.view">
        <field name="name">sapione.hr.certificate.form</field>
        <field name="model">sapione.hr.certificate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên chứng chỉ"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_id"/>
                            <field name="number"/>
                            <field name="issuing_organization"/>
                        </group>
                        <group>
                            <field name="date_issued"/>
                            <field name="date_expiry"/>
                            <field name="state" widget="badge"
                                   decoration-success="state in ('valid', 'no_expiry')"
                                   decoration-warning="state == 'expiring'"
                                   decoration-danger="state == 'expired'"/>
                            <field name="document" filename="document_filename"/>
                            <field name="document_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_certificate_search" model="ir.ui.view">
        <field name="name">sapione.hr.certificate.search</field>
        <field name="model">sapione.hr.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="number"/>
                <filter name="f_expired" string="Hết hạn"
                        domain="[('date_expiry', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_expiring" string="Sắp hết hạn (60 ngày)"
                        domain="[('date_expiry', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_expiry', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter name="f_valid" string="Còn hạn"
                        domain="['|', ('date_expiry', '=', False), ('date_expiry', '&gt;', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="g_employee" string="Nhân viên" context="{'group_by': 'employee_id'}"/>
                <filter name="g_category" string="Nhóm" context="{'group_by': 'category'}"/>
                <filter name="g_type" string="Loại" context="{'group_by': 'type_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_certificate" model="ir.actions.act_window">
        <field name="name">Chứng chỉ nhân viên</field>
        <field name="res_model">sapione.hr.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_certificate_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có chứng chỉ nào</p>
            <p>Quản lý chứng chỉ/bằng cấp của nhân viên và theo dõi ngày hết hạn.</p>
        </field>
    </record>

    <!-- ===== Loại chứng chỉ ===== -->
    <record id="view_certificate_type_list" model="ir.ui.view">
        <field name="name">sapione.hr.certificate.type.list</field>
        <field name="model">sapione.hr.certificate.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="default_validity_months"/>
                <field name="is_mandatory"/>
            </list>
        </field>
    </record>

    <record id="action_certificate_type" model="ir.actions.act_window">
        <field name="name">Loại chứng chỉ</field>
        <field name="res_model">sapione.hr.certificate.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
