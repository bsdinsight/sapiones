<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_certificate" model="ir.ui.view">
        <field name="name">hr.employee.form.certificate</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Chứng chỉ" name="sapione_certificates" groups="hr.group_hr_user">
                    <field name="certificate_alert" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not certificate_alert">
                        ⚠️ Nhân viên có chứng chỉ đã hết hạn — vui lòng kiểm tra và gia hạn.
                    </div>
                    <field name="certificate_ids" context="{'default_employee_id': id}">
                        <list editable="bottom"
                              decoration-danger="state == 'expired'"
                              decoration-warning="state == 'expiring'">
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="number"/>
                            <field name="issuing_organization" optional="hide"/>
                            <field name="date_issued"/>
                            <field name="date_expiry"/>
                            <field name="state" widget="badge"
                                   decoration-success="state in ('valid', 'no_expiry')"
                                   decoration-warning="state == 'expiring'"
                                   decoration-danger="state == 'expired'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
